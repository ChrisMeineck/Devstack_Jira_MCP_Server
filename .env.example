# Pflicht: Dein VW-Group-Jira Personal Access Token
JIRA_PAT=

# Jira-Basis-URL (Standard: devstack VW Group)
JIRA_BASE_URL=https://devstack.vwgroup.com/jira

# Default-Projektschluessel (wird in Tool-Beschreibungen als Hint genutzt,
# damit Copilot bei vagen Anfragen "in PPSE suchen" das richtige Projekt waehlt).
JIRA_DEFAULT_PROJECT_KEY=PPSE

# MCP-Transport: http (default) oder stdio
MCP_TRANSPORT=http

# Port fuer den HTTP-Transport
MCP_PORT=8766

# HTTP-Request-Timeout in Sekunden
JIRA_HTTP_TIMEOUT=30
